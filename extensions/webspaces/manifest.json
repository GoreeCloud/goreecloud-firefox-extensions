{
  "manifest_version": 3,
  "name": "GoreeCloud Webspaces",
  "version": "0.1.7",
  "description": "Isolated Firefox browsing environments with deterministic site routing and multi-account separation.",
  "icons": {
    "48": "icons/webspaces.svg",
    "96": "icons/webspaces.svg"
  },
  "permissions": [
    "activeTab",
    "contextualIdentities",
    "cookies",
    "menus",
    "storage",
    "webNavigation"
  ],
  "action": {
    "default_title": "GoreeCloud Webspaces",
    "default_icon": "icons/webspaces.svg",
    "default_popup": "ui/popup.html"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "src/background.js",
      "src/routing-settings-background.js"
    ],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "webspaces@goreecloud.com"
    }
  }
}
