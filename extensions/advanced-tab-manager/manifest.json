{
  "manifest_version": 3,
  "name": "GoreeCloud Advanced Tab Manager",
  "version": "0.1.5",
  "description": "Local-first Firefox tab organization with durable recovery and deterministic explainable rule evaluation.",
  "homepage_url": "https://github.com/GoreeCloud/goreecloud-firefox-extensions",
  "incognito": "not_allowed",
  "permissions": [
    "alarms",
    "sessions",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "action": {
    "default_title": "GoreeCloud Advanced Tab Manager",
    "default_popup": "src/popup/popup.html"
  },
  "sidebar_action": {
    "default_title": "GoreeCloud Advanced Tab Manager",
    "default_panel": "src/sidebar/sidebar.html"
  },
  "background": {
    "scripts": [
      "src/background/background.js"
    ],
    "persistent": false,
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "advanced-tab-manager@goreecloud.com",
      "strict_min_version": "139.0"
    }
  }
}
